{
  "name": "lite-code",
  "private": true,
  "version": "0.6.1-preview.7",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm --filter @lite-code/web lint",
    "typecheck": "pnpm --filter @lite-code/web typecheck",
    "test": "pnpm --filter @lite-code/web test",
    "build": "pnpm --filter @lite-code/web build",
    "db:bridge:build": "pnpm --filter @lite-code/db-bridge build",
    "db:bridge:build:check": "pnpm --filter @lite-code/db-bridge build:check",
    "db:bridge:check": "pnpm --filter @lite-code/db-bridge check",
    "db:bridge:test": "pnpm --filter @lite-code/db-bridge test",
    "tauri": "tauri",
    "contract:codegen": "cargo run --locked -p lc-proto --features codegen --bin codegen"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17"
    }
  }
}
